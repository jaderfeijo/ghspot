# Regenerate the README media: vhs demo.tape
Output assets/demo.gif

Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 15
Set Width 1600
Set Height 880
Set Theme "TokyoNight"
Set Padding 18
Set Margin 28
Set MarginFill "#5a4fcf"
Set BorderRadius 12
Set WindowBar Colorful
Set TypingSpeed 90ms
Set Framerate 24

Hide
Type "ghspot -R cli/cli" Enter
Sleep 9s
Show

Sleep 1s
Type "keyring auth"
Sleep 2s
Down
Sleep 2s
Screenshot assets/search.png
Sleep 1s

Enter
Sleep 3s
Screenshot assets/reader.png
Type "jjjjjjjj"
Sleep 1s
Type "n"
Sleep 2s
Escape
Sleep 1s

Ctrl+U
Type "#42"
Sleep 7s
Screenshot assets/number.png
Sleep 1s

Tab
Sleep 800ms
Ctrl+S
Sleep 800ms
Ctrl+U
Type "release notes"
Sleep 9s
Screenshot assets/filters.png
Sleep 1s

Hide
Ctrl+C
Type "clear; ghspot --org charmbracelet" Enter
Sleep 14s
Show

Type "glamour table"
Sleep 7s
Screenshot assets/repo-scope.png
Sleep 2s
